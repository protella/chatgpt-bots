#!/usr/bin/env bash
# Last line of defence before a real name reaches a PUBLIC repository.
#
# Install with `make install-hooks` (git hooks live in .git/, which is not tracked, so every
# clone has to copy this in once).
#
# The same scan runs as a unit test, so this hook is redundant on a normal `make check` — which
# is exactly the point. Both leaks this guard exists to prevent happened on commits where the
# suite was not run.
set -euo pipefail

repo="$(git rev-parse --show-toplevel)"
cd "$repo"

if ! python3 -m tools.pii_scan; then
    cat >&2 <<'EOF'

COMMIT BLOCKED — see the findings above.

This repository is PUBLIC. Real names, internal channel names and credentials must never be
committed. Use the fictional cast in tests/fixtures/people.py; add a character there if the one
you need does not exist yet.

To bypass in a genuine false positive (and then fix the scanner):  git commit --no-verify
EOF
    exit 1
fi
