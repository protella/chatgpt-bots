# secrets — must stay a wildcard. A bare `.env` rule matches ONLY that exact name:
# siblings like `.env.bak-keep.txt` sail straight past it. Ignore anything env-shaped
# by default and add an explicit negation for the rare file meant to be published.
.env*
!.env.example

# VSCode
.vscode/

# lib64 and venv config
lib64
pyvenv.cfg

#v-environment binaries
bin/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# Translations
*.mo
*.pot

# IPython
profile_default/
ipython_config.py

# pyenv
.python-version

# PEP 582; used by e.g. github.com/David-OConnor/pyflow
__pypackages__/

# Environments (all .env* is ignored at the top of this file)
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# ruff
.ruff_cache/

# Local logs — keep the directory, ignore everything written into it.
# Must stay `logs/*`: a blanket `logs/` rule excludes the directory itself, and
# git cannot re-include a file inside an excluded directory, which silently
# defeats the !logs/.gitkeep negation below.
logs/*
!logs/.gitkeep
*.log

# Editor and scaffolding folders that exist only in a working copy. Both are still present in
# clones that predate their removal from git, so the rules stay until those are cleaned up.
.cursor/
.bmad-*/

# SQLite databases
data/*
!data/.gitkeep
!data/backups/
data/backups/*
!data/backups/.gitkeep
*.db
*.db-wal
*.db-shm

# Local-only reports, caches, and configs
metrics_reports/
mcp_config.json
mcp_config*.bak
.mcp.json
.channels_cache_v2.json
.users_cache.json

# Claude Code local settings (note: .claude/skills/** IS tracked)
.claude/settings.local.json

# Claude Image Paste screenshots
.cp-images/

# Slack app manifest (environment-specific; use slack_app_manifest.example.yml as template)
slack_app_manifest.yml

# Company-branded loading messages stay local (like .env) — the generic set is the committed default
status_messages/loading_messages.*.txt
!status_messages/loading_messages.generic.txt

# Working specs co-authored by Claude + codex (never published: internal IDs, live plans)
Docs/specs/

# Relocated auto-memory notes (internal, never published)
# This repo is PUBLIC: these files hold internal Slack channel names/IDs, employee
# references, and operational detail that must not be committed.
Docs/internal/

# Playwright MCP browser-session artifacts
.playwright-mcp/

# Prod deployment checklist — internal implementation notes, never published
Docs/V3_PROD_DEPLOYMENT_CHECKLIST.md
